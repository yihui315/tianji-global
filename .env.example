# ============================================================
# TianJi Global — Production Environment Variables Example
# ============================================================
# Copy this file to .env.local for local development.
# For production, set these in your hosting environment
# (e.g., PM2 environment variables, Vercel env vars,
#  Docker env, or a secrets manager).
#
# NEVER commit real secret values to the repository.
# NEVER paste secrets into docs, PRs, or chat.
# ============================================================

# ─── Core ───────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# Public URL of the deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL=https://tianji.love

# NextAuth / Auth.js configuration
NEXTAUTH_URL=https://tianji.love
AUTH_URL=https://tianji.love

# Secret used to sign NextAuth JWTs and session tokens.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Alias for AUTH_SECRET (NextAuth v5 prefers AUTH_SECRET)
AUTH_SECRET=

# ─── Google OAuth ───────────────────────────────────────────────────────────

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Database (PostgreSQL via @auth/pg-adapter) ─────────────────────────────

# PostgreSQL connection string, e.g.:
# postgresql://user:password@localhost:5432/tianji
DATABASE_URL=

# ─── Resend (Transactional Email) ───────────────────────────────────────────

# Resend API key from https://resend.com
RESEND_API_KEY=

# Verified sender email address, e.g.: TianJi <no-reply@tianji.love>
EMAIL_FROM=

# Set to "true" to disable all email sending (useful for degraded/canary mode)
EMAIL_SEND_DISABLED=false

# ─── Supabase ───────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only; never expose to the browser or commit to version control.
SUPABASE_SERVICE_ROLE_KEY=

# Set to "true" to disable all Supabase write operations (degraded/canary mode)
SUPABASE_MUTATION_DISABLED=false

# ─── Stripe ─────────────────────────────────────────────────────────────────

# Secret key from Stripe dashboard (use sk_test_... for test mode,
# sk_live_... for production). Keep extremely secret.
STRIPE_SECRET_KEY=

# Webhook signing secret from Stripe dashboard (whsec_...).
# See docs/PRODUCTION_DEPLOY.md §Stripe Webhook Setup for how to obtain this.
STRIPE_WEBHOOK_SECRET=

# Publishable key visible in the browser (pk_test_... or pk_live_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Set to "true" to disable live Stripe payment processing (degraded/canary mode)
STRIPE_LIVE_DISABLED=false

# ─── Stripe Price IDs ───────────────────────────────────────────────────────
# Create these in the Stripe dashboard for each product/subscription.

# One-time unlock prices
STRIPE_ASK_PRICE_ID=          # Ask question one-time unlock
STRIPE_DRAW_PRICE_ID=         # Draw tarot one-time unlock

# Subscription prices
STRIPE_PRO_MONTHLY_PRICE_ID=  # Pro monthly subscription
STRIPE_PRO_YEARLY_PRICE_ID=   # Pro yearly subscription

# Love premium report one-time price
STRIPE_LOVE_PREMIUM_REPORT_PRICE_ID=

# ─── AI Providers ───────────────────────────────────────────────────────────
# At least one AI provider key is required for live AI features.
# Ollama (local) requires no API key — set OLLAMA_BASE_URL only.
#
# Provider availability is auto-detected: if the *_API_KEY env var is set,
# that provider is considered available for routing.
# Multiple providers can be set; the app selects based on task type and cost.

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# MiniMax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1

# MiniMax token plan key (used for quota/gating checks)
MINIMAX_TOKEN_PLAN_KEY=

# Gemini / Google AI
# Supports both GEMINI_API_KEY and GOOGLE_API_KEY env var names.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Grok (xAI)
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1

# Ollama (local inference server — no API key required)
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Packy API (custom provider)
PACKY_API_ENDPOINT=
# OPENAI_API_KEY is reused for Packy when PACKY_API_ENDPOINT is set.

# ─── AI Feature Flags ───────────────────────────────────────────────────────

# Set to "true" to disable live AI provider calls (degraded/canary mode)
AI_PROVIDER_LIVE_DISABLED=false

# AI runtime mode: "local", "hybrid", or provider-routed
AI_RUNTIME_MODE=local

# Free preview provider and model (used for non-paid previews)
AI_FREE_PREVIEW_PROVIDER=ollama
AI_FREE_PREVIEW_MODEL=gemma4:31b

# Router provider and model (used for model gateway routing)
AI_ROUTER_PROVIDER=ollama
AI_ROUTER_MODEL=gemma4:31b

# Safety rewrite: set to "true" to enable AI output safety rewriting
AI_ENABLE_SAFETY_REWRITE=true

# Cost and fallback observability flags
AI_ENABLE_COST_LOGGING=true
AI_ENABLE_FALLBACK_LOGGING=true

# ─── App Feature Flags ──────────────────────────────────────────────────────

# Public environment label: "production" or "staging"
NEXT_PUBLIC_APP_ENV=production

# Degraded mode: disables live payments, AI, email, Supabase mutations
# when set to "true". Used for free canary or staging smoke.
STAGING_DEGRADED_MODE=false

# Staging base URL (used by smoke scripts when not targeting production)
STAGING_BASE_URL=https://staging.example.com

# ─── Vedic Astrology ────────────────────────────────────────────────────────

# Set to "true" to enable Vedic paid public report routes
NEXT_PUBLIC_TIANJI_VEDIC_ENABLED=false
TIANJI_VEDIC_REPORT_MODE=disabled

# ─── Optional: Telegram Bot ─────────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=

# ─── Optional: Ask Question Secret ─────────────────────────────────────────
# Used to sign ask-question API payloads. Falls back to NEXTAUTH_SECRET.
ASK_QUESTION_SECRET=
DESTINY_SCAN_SECRET=
